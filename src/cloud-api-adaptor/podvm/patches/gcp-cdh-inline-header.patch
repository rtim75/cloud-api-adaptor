+#[cfg(test)]
+mod gcp_persistent_header_tests {
+    use super::*;
+    use std::io::Read;
+
+    #[test]
+    fn gcp_inline_header_reopens_and_copies_without_guest_state() {
+        let data = tempfile::NamedTempFile::new().unwrap();
+        data.as_file().set_len(64 * 1024 * 1024).unwrap();
+        let path = data.path().to_str().unwrap();
+        let mut key = Zeroizing::new(vec![0u8; 32]);
+        std::fs::File::open("/dev/urandom")
+            .unwrap()
+            .read_exact(&mut key)
+            .unwrap();
+        let formatter = Luks2Formatter::default();
+        formatter
+            .prepare_persistent_device(path, key.clone(), &SourceType::Empty)
+            .unwrap();
+        run_cryptsetup(&["isLuks", path]).unwrap();
+        let before = std::fs::read(path).unwrap();
+        assert_eq!(&before[..6], b"LUKS\xba\xbe");
+        formatter
+            .prepare_persistent_device(path, key.clone(), &SourceType::Encrypted)
+            .unwrap();
+        run_cryptsetup_stdin(
+            &["open", "--test-passphrase", "--key-file", "-", path],
+            &key,
+        )
+        .unwrap();
+        let wrong_key = Zeroizing::new(vec![0u8; 32]);
+        assert!(run_cryptsetup_stdin(
+            &["open", "--test-passphrase", "--key-file", "-", path],
+            &wrong_key
+        )
+        .is_err());
+        assert_eq!(before, std::fs::read(path).unwrap());
+        let copy = tempfile::NamedTempFile::new().unwrap();
+        std::fs::copy(path, copy.path()).unwrap();
+        run_cryptsetup_stdin(
+            &[
+                "open",
+                "--test-passphrase",
+                "--key-file",
+                "-",
+                copy.path().to_str().unwrap(),
+            ],
+            &key,
+        )
+        .unwrap();
+        assert_eq!(before, std::fs::read(copy.path()).unwrap());
+    }
+}
